{
  "version": 3,
  "categories": [
    { "key": "application", "label": "Application" },
    { "key": "data", "label": "Data" },
    { "key": "general", "label": "General" },
    { "key": "deployment", "label": "Deployment" }
  ],
  "propertyTypes": ["string", "text", "number", "boolean", "enum", "list"],
  "types": {
    "client": {
      "label": "Client", "category": "application", "layer": "logical", "icon": "▭", "nodeKind": "component", "views": ["logical"],
      "aliases": ["web", "mobile", "browser", "frontend"],
      "properties": [
        { "key": "channel", "label": "채널", "type": "enum", "options": ["web", "mobile", "desktop", "cli"] }
      ]
    },
    "gateway": {
      "label": "Gateway", "category": "application", "layer": "logical", "icon": "⇲", "nodeKind": "component", "views": ["logical"],
      "aliases": ["api gateway", "ingress", "proxy", "nginx"],
      "properties": [
        { "key": "product", "label": "제품", "type": "string", "placeholder": "Spring Cloud Gateway" },
        { "key": "rateLimit", "label": "요청 제한", "type": "string", "placeholder": "100 req/s" }
      ]
    },
    "service": {
      "label": "Service", "category": "application", "layer": "logical", "icon": "⬢", "nodeKind": "component", "views": ["logical"],
      "aliases": ["api", "backend", "server", "microservice"],
      "properties": [
        { "key": "runtime", "label": "Runtime", "type": "string", "placeholder": "Java 21" },
        { "key": "port", "label": "Port", "type": "number", "min": 1, "max": 65535, "integer": true },
        { "key": "stateless", "label": "Stateless", "type": "boolean", "default": true },
        { "key": "replicas", "label": "Replicas", "type": "number", "min": 0, "max": 1000, "integer": true }
      ]
    },
    "worker": {
      "label": "Worker", "category": "application", "layer": "logical", "icon": "⚙", "nodeKind": "component", "views": ["logical"],
      "aliases": ["batch", "job", "cron", "consumer"],
      "properties": [
        { "key": "runtime", "label": "Runtime", "type": "string" },
        { "key": "trigger", "label": "실행 방식", "type": "enum", "options": ["schedule", "queue", "event"] },
        { "key": "schedule", "label": "스케줄", "type": "string", "placeholder": "0 3 * * *" }
      ]
    },
    "external": {
      "label": "External", "category": "application", "layer": "logical", "icon": "◌", "nodeKind": "component", "views": ["logical"],
      "aliases": ["3rd party", "saas", "partner"],
      "properties": [
        { "key": "owner", "label": "담당", "type": "string" },
        { "key": "contractRef", "label": "계약 참조", "type": "string", "placeholder": "OpenAPI URL 또는 문서 이름" }
      ]
    },
    "database": {
      "label": "Database", "category": "data", "layer": "logical", "icon": "◫", "nodeKind": "component", "views": ["logical"],
      "aliases": ["db", "postgres", "postgresql", "mysql", "mongodb", "rdbms"],
      "properties": [
        { "key": "engine", "label": "엔진", "type": "enum", "options": ["postgres", "mysql", "mongodb", "other"] },
        { "key": "version", "label": "버전", "type": "string" },
        { "key": "ha", "label": "고가용성", "type": "enum", "options": ["none", "replica", "multi-az"] }
      ]
    },
    "cache": {
      "label": "Cache", "category": "data", "layer": "logical", "icon": "⚡", "nodeKind": "component", "views": ["logical"],
      "aliases": ["redis", "memcached"],
      "properties": [
        { "key": "engine", "label": "엔진", "type": "enum", "options": ["redis", "memcached", "other"] },
        { "key": "purpose", "label": "용도", "type": "enum", "options": ["cache", "session", "rate-limit", "lock"] },
        { "key": "ttl", "label": "TTL", "type": "string", "placeholder": "10m" }
      ]
    },
    "queue": {
      "label": "Queue", "category": "data", "layer": "logical", "icon": "☰", "nodeKind": "component", "views": ["logical"],
      "aliases": ["kafka", "rabbitmq", "sqs", "mq", "topic"],
      "properties": [
        { "key": "engine", "label": "엔진", "type": "enum", "options": ["kafka", "rabbitmq", "sqs", "other"] },
        { "key": "topic", "label": "토픽·큐 이름", "type": "string" }
      ]
    },
    "storage": {
      "label": "Storage", "category": "data", "layer": "logical", "icon": "▥", "nodeKind": "component", "views": ["logical"],
      "aliases": ["s3", "blob", "bucket", "file"],
      "properties": [
        { "key": "kind", "label": "종류", "type": "enum", "options": ["object", "block", "file"] },
        { "key": "bucket", "label": "버킷·경로", "type": "string" }
      ]
    },
    "group": {
      "label": "Boundary", "category": "general", "layer": "general", "icon": "⬚", "nodeKind": "group", "views": ["logical"],
      "aliases": ["group", "boundary", "zone"],
      "properties": []
    },
    "note": {
      "label": "Note", "category": "general", "layer": "general", "icon": "✎", "nodeKind": "note", "views": ["logical"],
      "aliases": ["memo", "comment"],
      "properties": []
    },
    "dep.environment": {
      "label": "Environment", "category": "deployment", "layer": "deployment", "icon": "▣", "nodeKind": "component", "views": ["deployment"],
      "container": true, "aliases": ["environment", "env"],
      "properties": [
        { "key": "stage", "label": "단계", "type": "enum", "options": ["local", "dev", "staging", "prod"] }
      ]
    },
    "dep.zone": {
      "label": "Network Zone", "category": "deployment", "layer": "deployment", "icon": "▦", "nodeKind": "component", "views": ["deployment"],
      "container": true, "aliases": ["zone", "subnet", "network"],
      "properties": [
        { "key": "trust", "label": "신뢰 구역", "type": "enum", "options": ["external", "dmz", "internal", "data"], "default": "internal" }
      ]
    },
    "dep.platform": {
      "label": "Platform (PaaS)", "category": "deployment", "layer": "deployment", "icon": "☁", "nodeKind": "component", "views": ["deployment"],
      "container": true, "aliases": ["paas", "vercel", "railway", "render", "heroku"],
      "properties": [
        { "key": "provider", "label": "제공자", "type": "string", "placeholder": "Railway" },
        { "key": "region", "label": "리전", "type": "string", "placeholder": "ap-northeast-1" }
      ]
    },
    "dep.vm": {
      "label": "VM / Host", "category": "deployment", "layer": "deployment", "icon": "▭", "nodeKind": "component", "views": ["deployment"],
      "container": true, "aliases": ["vm", "host", "server", "ec2"],
      "properties": [
        { "key": "os", "label": "OS", "type": "string", "placeholder": "Ubuntu 24.04" },
        { "key": "cpu", "label": "vCPU", "type": "number", "min": 0 },
        { "key": "memoryGb", "label": "메모리(GB)", "type": "number", "min": 0 },
        { "key": "count", "label": "대수", "type": "number", "integer": true, "min": 1, "default": 1 }
      ]
    },
    "dep.lb": {
      "label": "Load Balancer", "category": "deployment", "layer": "deployment", "icon": "⇋", "nodeKind": "component", "views": ["deployment"],
      "aliases": ["lb", "load balancer", "nginx", "haproxy", "alb"],
      "properties": [
        { "key": "layer", "label": "계층", "type": "enum", "options": ["L4", "L7"] },
        { "key": "provider", "label": "제공자", "type": "string" }
      ]
    },
    "dep.managed_db": {
      "label": "Managed DB", "category": "deployment", "layer": "deployment", "icon": "⛁", "nodeKind": "component", "views": ["deployment"],
      "realizes": true, "aliases": ["dbaas", "supabase", "rds", "managed db"],
      "properties": [
        { "key": "provider", "label": "제공자", "type": "string", "placeholder": "Supabase" },
        { "key": "engine", "label": "엔진", "type": "string", "placeholder": "PostgreSQL" },
        { "key": "plan", "label": "플랜", "type": "string" }
      ]
    },
    "dep.managed_auth": {
      "label": "Managed Auth", "category": "deployment", "layer": "deployment", "icon": "⚿", "nodeKind": "component", "views": ["deployment"],
      "realizes": true, "aliases": ["auth service", "idp", "supabase auth", "auth0", "cognito"],
      "properties": [
        { "key": "provider", "label": "제공자", "type": "string", "placeholder": "Supabase Auth" }
      ]
    },
    "dep.process": {
      "label": "Process", "category": "deployment", "layer": "deployment", "icon": "⚙", "nodeKind": "component", "views": ["deployment"],
      "realizes": true, "aliases": ["process", "app", "container", "service instance"],
      "properties": [
        { "key": "runtime", "label": "런타임", "type": "string", "placeholder": "Node.js 24" },
        { "key": "startCommand", "label": "시작 명령", "type": "string", "placeholder": "npm start" },
        { "key": "port", "label": "포트", "type": "number", "integer": true, "min": 1, "max": 65535 },
        { "key": "instances", "label": "인스턴스 수", "type": "number", "integer": true, "min": 1, "default": 1 }
      ]
    }
  }
}
